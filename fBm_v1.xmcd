		<region region-id="112" left="12" top="1347" width="287.25" height="246.75" align-x="48.75" align-y="1362" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">spI2</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">L</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:mult style="auto-select"/>
						<ml:apply>
							<ml:pow/>
							<ml:id xml:space="preserve">T</ml:id>
							<ml:real>2</ml:real>
						</ml:apply>
						<ml:program>
							<ml:for>
								<ml:id xml:space="preserve">m</ml:id>
								<ml:range>
									<ml:real>0</ml:real>
									<ml:apply>
										<ml:minus/>
										<ml:id xml:space="preserve">L</ml:id>
										<ml:real>1</ml:real>
									</ml:apply>
								</ml:range>
								<ml:program>
									<ml:localDefine>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">c</ml:id>
											<ml:sequence>
												<ml:id xml:space="preserve">m</ml:id>
												<ml:id xml:space="preserve">m</ml:id>
											</ml:sequence>
										</ml:apply>
										<ml:program>
											<ml:ifThen>
												<ml:apply>
													<ml:equal/>
													<ml:id xml:space="preserve">m</ml:id>
													<ml:real>0</ml:real>
												</ml:apply>
												<ml:apply>
													<ml:div/>
													<ml:real>1</ml:real>
													<ml:real>6</ml:real>
												</ml:apply>
											</ml:ifThen>
											<ml:otherwise>
												<ml:apply>
													<ml:neg/>
													<ml:apply>
														<ml:div/>
														<ml:real>1</ml:real>
														<ml:apply>
															<ml:mult style="auto-select"/>
															<ml:real>2</ml:real>
															<ml:apply>
																<ml:mult style="auto-select"/>
																<ml:parens>
																	<ml:apply>
																		<ml:minus/>
																		<ml:apply>
																			<ml:mult style="auto-select"/>
																			<ml:real>2</ml:real>
																			<ml:id xml:space="preserve">m</ml:id>
																		</ml:apply>
																		<ml:real>1</ml:real>
																	</ml:apply>
																</ml:parens>
																<ml:parens>
																	<ml:apply>
																		<ml:plus/>
																		<ml:apply>
																			<ml:mult style="auto-select"/>
																			<ml:real>2</ml:real>
																			<ml:id xml:space="preserve">m</ml:id>
																		</ml:apply>
																		<ml:real>3</ml:real>
																	</ml:apply>
																</ml:parens>
															</ml:apply>
														</ml:apply>
													</ml:apply>
												</ml:apply>
											</ml:otherwise>
										</ml:program>
									</ml:localDefine>
									<ml:ifThen>
										<ml:apply>
											<ml:greaterThan/>
											<ml:id xml:space="preserve">m</ml:id>
											<ml:real>0</ml:real>
										</ml:apply>
										<ml:program>
											<ml:ifThen>
												<ml:apply>
													<ml:equal/>
													<ml:id xml:space="preserve">m</ml:id>
													<ml:real>1</ml:real>
												</ml:apply>
												<ml:localDefine>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">c</ml:id>
														<ml:sequence>
															<ml:apply>
																<ml:minus/>
																<ml:id xml:space="preserve">m</ml:id>
																<ml:real>1</ml:real>
															</ml:apply>
															<ml:id xml:space="preserve">m</ml:id>
														</ml:sequence>
													</ml:apply>
													<ml:apply>
														<ml:neg/>
														<ml:apply>
															<ml:div/>
															<ml:real>1</ml:real>
															<ml:apply>
																<ml:mult style="auto-select"/>
																<ml:real>4</ml:real>
																<ml:apply>
																	<ml:sqrt/>
																	<ml:real>3</ml:real>
																</ml:apply>
															</ml:apply>
														</ml:apply>
													</ml:apply>
												</ml:localDefine>
											</ml:ifThen>
											<ml:localDefine>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">c</ml:id>
													<ml:sequence>
														<ml:id xml:space="preserve">m</ml:id>
														<ml:apply>
															<ml:minus/>
															<ml:id xml:space="preserve">m</ml:id>
															<ml:real>1</ml:real>
														</ml:apply>
													</ml:sequence>
												</ml:apply>
												<ml:apply>
													<ml:neg/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">c</ml:id>
														<ml:sequence>
															<ml:apply>
																<ml:minus/>
																<ml:id xml:space="preserve">m</ml:id>
																<ml:real>1</ml:real>
															</ml:apply>
															<ml:id xml:space="preserve">m</ml:id>
														</ml:sequence>
													</ml:apply>
												</ml:apply>
											</ml:localDefine>
										</ml:program>
									</ml:ifThen>
									<ml:ifThen>
										<ml:apply>
											<ml:greaterThan/>
											<ml:id xml:space="preserve">m</ml:id>
											<ml:real>1</ml:real>
										</ml:apply>
										<ml:program>
											<ml:localDefine>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">c</ml:id>
													<ml:sequence>
														<ml:apply>
															<ml:minus/>
															<ml:id xml:space="preserve">m</ml:id>
															<ml:real>2</ml:real>
														</ml:apply>
														<ml:id xml:space="preserve">m</ml:id>
													</ml:sequence>
												</ml:apply>
												<ml:apply>
													<ml:div/>
													<ml:real>1</ml:real>
													<ml:apply>
														<ml:mult style="auto-select"/>
														<ml:real>4</ml:real>
														<ml:apply>
															<ml:sqrt/>
															<ml:apply>
																<ml:mult style="auto-select"/>
																<ml:parens>
																	<ml:apply>
																		<ml:minus/>
																		<ml:apply>
																			<ml:mult style="auto-select"/>
																			<ml:real>4</ml:real>
																			<ml:apply>
																				<ml:pow/>
																				<ml:parens>
																					<ml:apply>
																						<ml:minus/>
																						<ml:id xml:space="preserve">m</ml:id>
																						<ml:real>1</ml:real>
																					</ml:apply>
																				</ml:parens>
																				<ml:real>2</ml:real>
																			</ml:apply>
																		</ml:apply>
																		<ml:real>1</ml:real>
																	</ml:apply>
																</ml:parens>
																<ml:parens>
																	<ml:apply>
																		<ml:minus/>
																		<ml:apply>
																			<ml:mult style="auto-select"/>
																			<ml:real>4</ml:real>
																			<ml:apply>
																				<ml:pow/>
																				<ml:id xml:space="preserve">m</ml:id>
																				<ml:real>2</ml:real>
																			</ml:apply>
																		</ml:apply>
																		<ml:real>1</ml:real>
																	</ml:apply>
																</ml:parens>
															</ml:apply>
														</ml:apply>
													</ml:apply>
												</ml:apply>
											</ml:localDefine>
											<ml:localDefine>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">c</ml:id>
													<ml:sequence>
														<ml:id xml:space="preserve">m</ml:id>
														<ml:apply>
															<ml:minus/>
															<ml:id xml:space="preserve">m</ml:id>
															<ml:real>2</ml:real>
														</ml:apply>
													</ml:sequence>
												</ml:apply>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">c</ml:id>
													<ml:sequence>
														<ml:apply>
															<ml:minus/>
															<ml:id xml:space="preserve">m</ml:id>
															<ml:real>2</ml:real>
														</ml:apply>
														<ml:id xml:space="preserve">m</ml:id>
													</ml:sequence>
												</ml:apply>
											</ml:localDefine>
										</ml:program>
									</ml:ifThen>
								</ml:program>
							</ml:for>
							<ml:id xml:space="preserve">c</ml:id>
