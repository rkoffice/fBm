		<region region-id="89" left="12" top="1676.25" width="554.25" height="123.75" align-x="66" align-y="1692" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">spKH</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">L</ml:id>
							<ml:id xml:space="preserve">H</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:program>
						<ml:ifThen>
							<ml:apply>
								<ml:equal/>
								<ml:id xml:space="preserve">H</ml:id>
								<ml:apply>
									<ml:div/>
									<ml:real>1</ml:real>
									<ml:real>2</ml:real>
								</ml:apply>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">spI</ml:id>
								<ml:id xml:space="preserve">L</ml:id>
							</ml:apply>
						</ml:ifThen>
						<ml:ifThen>
							<ml:apply>
								<ml:lessThan/>
								<ml:id xml:space="preserve">H</ml:id>
								<ml:apply>
									<ml:div/>
									<ml:real>1</ml:real>
									<ml:real>2</ml:real>
								</ml:apply>
							</ml:apply>
							<ml:apply>
								<ml:mult/>
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:sqrt/>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:mult style="auto-select"/>
													<ml:real>2</ml:real>
													<ml:id xml:space="preserve">H</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:parens>
														<ml:apply>
															<ml:minus/>
															<ml:real>1</ml:real>
															<ml:apply>
																<ml:mult style="auto-select"/>
																<ml:real>2</ml:real>
																<ml:id xml:space="preserve">H</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:parens>
													<ml:apply>
														<ml:id xml:space="preserve">B</ml:id>
														<ml:sequence>
															<ml:apply>
																<ml:minus/>
																<ml:real>1</ml:real>
																<ml:apply>
																	<ml:mult style="auto-select"/>
																	<ml:real>2</ml:real>
																	<ml:id xml:space="preserve">H</ml:id>
																</ml:apply>
															</ml:apply>
															<ml:apply>
																<ml:plus/>
																<ml:id xml:space="preserve">H</ml:id>
																<ml:apply>
																	<ml:div/>
																	<ml:real>1</ml:real>
																	<ml:real>2</ml:real>
																</ml:apply>
															</ml:apply>
														</ml:sequence>
													</ml:apply>
												</ml:apply>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:id xml:space="preserve">Γ</ml:id>
											<ml:apply>
												<ml:plus/>
												<ml:id xml:space="preserve">H</ml:id>
												<ml:apply>
													<ml:div/>
													<ml:real>1</ml:real>
													<ml:real>2</ml:real>
												</ml:apply>
											</ml:apply>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:id xml:space="preserve">spID</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">L</ml:id>
													<ml:apply>
														<ml:mult style="auto-select"/>
														<ml:real>2</ml:real>
														<ml:id xml:space="preserve">H</ml:id>
													</ml:apply>
												</ml:sequence>
											</ml:apply>
											<ml:apply>
												<ml:id xml:space="preserve">spAtα</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">L</ml:id>
													<ml:apply>
														<ml:minus/>
														<ml:apply>
															<ml:div/>
															<ml:real>1</ml:real>
															<ml:real>2</ml:real>
														</ml:apply>
														<ml:id xml:space="preserve">H</ml:id>
													</ml:apply>
												</ml:sequence>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:id xml:space="preserve">spID</ml:id>
											<ml:sequence>
												<ml:id xml:space="preserve">L</ml:id>
												<ml:apply>
													<ml:minus/>
													<ml:apply>
														<ml:div/>
														<ml:real>1</ml:real>
														<ml:real>2</ml:real>
													</ml:apply>
													<ml:id xml:space="preserve">H</ml:id>
												</ml:apply>
											</ml:sequence>
										</ml:apply>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:id xml:space="preserve">spAtα</ml:id>
									<ml:sequence>
										<ml:id xml:space="preserve">L</ml:id>
										<ml:apply>
											<ml:minus/>
											<ml:id xml:space="preserve">H</ml:id>
											<ml:apply>
												<ml:div/>
												<ml:real>1</ml:real>
												<ml:real>2</ml:real>
											</ml:apply>
										</ml:apply>
									</ml:sequence>
								</ml:apply>
							</ml:apply>
						</ml:ifThen>
						<ml:ifThen>
							<ml:apply>
								<ml:greaterThan/>
								<ml:id xml:space="preserve">H</ml:id>
								<ml:apply>
									<ml:div/>
									<ml:real>1</ml:real>
									<ml:real>2</ml:real>
								</ml:apply>
							</ml:apply>
							<ml:apply>
								<ml:mult/>
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:sqrt/>
													<ml:apply>
														<ml:div/>
														<ml:apply>
															<ml:mult/>
															<ml:id xml:space="preserve">H</ml:id>
															<ml:parens>
																<ml:apply>
																	<ml:minus/>
																	<ml:apply>
																		<ml:mult style="auto-select"/>
																		<ml:real>2</ml:real>
																		<ml:id xml:space="preserve">H</ml:id>
																	</ml:apply>
																	<ml:real>1</ml:real>
																</ml:apply>
															</ml:parens>
														</ml:apply>
														<ml:apply>
															<ml:id xml:space="preserve">B</ml:id>
															<ml:sequence>
																<ml:apply>
																	<ml:minus/>
																	<ml:real>2</ml:real>
																	<ml:apply>
																		<ml:mult style="auto-select"/>
																		<ml:real>2</ml:real>
																		<ml:id xml:space="preserve">H</ml:id>
																	</ml:apply>
																</ml:apply>
																<ml:apply>
																	<ml:minus/>
																	<ml:id xml:space="preserve">H</ml:id>
																	<ml:apply>
																		<ml:div/>
																		<ml:real>1</ml:real>
																		<ml:real>2</ml:real>
																	</ml:apply>
																</ml:apply>
															</ml:sequence>
														</ml:apply>
													</ml:apply>
												</ml:apply>
												<ml:apply>
													<ml:id xml:space="preserve">Γ</ml:id>
													<ml:apply>
														<ml:minus/>
														<ml:id xml:space="preserve">H</ml:id>
														<ml:apply>
															<ml:div/>
															<ml:real>1</ml:real>
															<ml:real>2</ml:real>
														</ml:apply>
													</ml:apply>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:id xml:space="preserve">spI</ml:id>
												<ml:id xml:space="preserve">L</ml:id>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:id xml:space="preserve">spAtα</ml:id>
											<ml:sequence>
												<ml:id xml:space="preserve">L</ml:id>
												<ml:apply>
													<ml:minus/>
													<ml:id xml:space="preserve">H</ml:id>
													<ml:apply>
														<ml:div/>
														<ml:real>1</ml:real>
														<ml:real>2</ml:real>
													</ml:apply>
												</ml:apply>
											</ml:sequence>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:id xml:space="preserve">spID</ml:id>
										<ml:sequence>
											<ml:id xml:space="preserve">L</ml:id>
											<ml:apply>
												<ml:minus/>
												<ml:id xml:space="preserve">H</ml:id>
												<ml:apply>
													<ml:div/>
													<ml:real>1</ml:real>
													<ml:real>2</ml:real>
												</ml:apply>
											</ml:apply>
										</ml:sequence>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:id xml:space="preserve">spAtα</ml:id>
									<ml:sequence>
										<ml:id xml:space="preserve">L</ml:id>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:div/>
												<ml:real>1</ml:real>
												<ml:real>2</ml:real>
											</ml:apply>
											<ml:id xml:space="preserve">H</ml:id>
										</ml:apply>
									</ml:sequence>
								</ml:apply>
							</ml:apply>
						</ml:ifThen>
					</ml:program>
				</ml:define>
