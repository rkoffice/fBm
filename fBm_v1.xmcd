		<region region-id="105" left="12" top="1190.25" width="397.5" height="12" align-x="39.75" align-y="1200" show-border="true" show-highlight="true" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="center" list-style-type="inherit" tabs="inherit">Spectral characteristic of the first- and second-order integration operators</p>
			</text>
		</region>
		<region region-id="110" left="12" top="1214.25" width="180.75" height="121.5" align-x="44.25" align-y="1230" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">spI</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">L</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:mult style="auto-select"/>
						<ml:id xml:space="preserve">T</ml:id>
						<ml:program>
							<ml:localDefine>
								<ml:apply>
									<ml:indexer/>
									<ml:id xml:space="preserve">c</ml:id>
									<ml:sequence>
										<ml:real>0</ml:real>
										<ml:real>0</ml:real>
									</ml:sequence>
								</ml:apply>
								<ml:apply>
									<ml:div/>
									<ml:real>1</ml:real>
									<ml:real>2</ml:real>
								</ml:apply>
							</ml:localDefine>
							<ml:for>
								<ml:id xml:space="preserve">m</ml:id>
								<ml:range>
									<ml:real>1</ml:real>
									<ml:apply>
										<ml:minus/>
										<ml:id xml:space="preserve">L</ml:id>
										<ml:real>1</ml:real>
									</ml:apply>
								</ml:range>
								<ml:program>
									<ml:localDefine>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">c</ml:id>
											<ml:sequence>
												<ml:apply>
													<ml:minus/>
													<ml:id xml:space="preserve">m</ml:id>
													<ml:real>1</ml:real>
												</ml:apply>
												<ml:id xml:space="preserve">m</ml:id>
											</ml:sequence>
										</ml:apply>
										<ml:apply>
											<ml:neg/>
											<ml:apply>
												<ml:div/>
												<ml:real>1</ml:real>
												<ml:apply>
													<ml:mult style="auto-select"/>
													<ml:real>2</ml:real>
													<ml:apply>
														<ml:sqrt/>
														<ml:apply>
															<ml:minus/>
															<ml:apply>
																<ml:mult style="auto-select"/>
																<ml:real>4</ml:real>
																<ml:apply>
																	<ml:pow/>
																	<ml:id xml:space="preserve">m</ml:id>
																	<ml:real>2</ml:real>
																</ml:apply>
															</ml:apply>
															<ml:real>1</ml:real>
														</ml:apply>
													</ml:apply>
												</ml:apply>
											</ml:apply>
										</ml:apply>
									</ml:localDefine>
									<ml:localDefine>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">c</ml:id>
											<ml:sequence>
												<ml:id xml:space="preserve">m</ml:id>
												<ml:apply>
													<ml:minus/>
													<ml:id xml:space="preserve">m</ml:id>
													<ml:real>1</ml:real>
												</ml:apply>
											</ml:sequence>
										</ml:apply>
										<ml:apply>
											<ml:neg/>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">c</ml:id>
