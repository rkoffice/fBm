												<ml:id xml:space="preserve">_p</ml:id>
												<ml:sequence>
													<ml:apply>
														<ml:minus/>
														<ml:id xml:space="preserve">i</ml:id>
														<ml:real>2</ml:real>
													</ml:apply>
													<ml:id xml:space="preserve">t</ml:id>
												</ml:sequence>
											</ml:apply>
										</ml:apply>
									</ml:apply>
								</ml:parens>
							</ml:apply>
						</ml:otherwise>
					</ml:program>
				</ml:define>
			</math>
