									<ml:indexer/>
									<ml:id xml:space="preserve">c</ml:id>
									<ml:id xml:space="preserve">i</ml:id>
								</ml:apply>
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:sqrt/>
										<ml:apply>
											<ml:div/>
											<ml:apply>
												<ml:plus/>
												<ml:apply>
													<ml:mult style="auto-select"/>
													<ml:real>2</ml:real>
													<ml:id xml:space="preserve">i</ml:id>
												</ml:apply>
												<ml:real>1</ml:real>
											</ml:apply>
											<ml:id xml:space="preserve">T</ml:id>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">c</ml:id>
										<ml:id xml:space="preserve">i</ml:id>
									</ml:apply>
								</ml:apply>
							</ml:localDefine>
						</ml:for>
						<ml:id xml:space="preserve">c</ml:id>
					</ml:program>
				</ml:define>
			</math>
		</region>
		<region region-id="63" left="12" top="530.25" width="397.5" height="12" align-x="39.75" align-y="540" show-border="true" show-highlight="true" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="center" list-style-type="inherit" tabs="inherit">Spectral characteristic of the power function</p>
			</text>
		</region>
		<region region-id="64" left="12" top="554.25" width="223.5" height="93.75" align-x="66" align-y="570" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">spFtα</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">L</ml:id>
							<ml:id xml:space="preserve">α</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:mult style="auto-select"/>
						<ml:apply>
							<ml:mult style="auto-select"/>
							<ml:apply>
								<ml:pow/>
								<ml:id xml:space="preserve">T</ml:id>
								<ml:id xml:space="preserve">α</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:sqrt/>
								<ml:id xml:space="preserve">T</ml:id>
							</ml:apply>
						</ml:apply>
						<ml:program>
							<ml:localDefine>
								<ml:apply>
									<ml:indexer/>
									<ml:id xml:space="preserve">c</ml:id>
									<ml:real>0</ml:real>
								</ml:apply>
								<ml:apply>
									<ml:div/>
									<ml:real>1</ml:real>
									<ml:apply>
										<ml:plus/>
										<ml:id xml:space="preserve">α</ml:id>
										<ml:real>1</ml:real>
									</ml:apply>
								</ml:apply>
							</ml:localDefine>
							<ml:for>
								<ml:id xml:space="preserve">i</ml:id>
								<ml:range>
									<ml:real>1</ml:real>
									<ml:apply>
										<ml:minus/>
										<ml:id xml:space="preserve">L</ml:id>
										<ml:real>1</ml:real>
									</ml:apply>
								</ml:range>
								<ml:localDefine>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">c</ml:id>
										<ml:id xml:space="preserve">i</ml:id>
									</ml:apply>
									<ml:apply>
										<ml:mult style="auto-select"/>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:sqrt/>
												<ml:apply>
													<ml:div/>
													<ml:apply>
														<ml:plus/>
														<ml:apply>
															<ml:mult style="auto-select"/>
															<ml:real font="0">2</ml:real>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
														<ml:real>1</ml:real>
													</ml:apply>
													<ml:apply>
														<ml:minus/>
														<ml:apply>
															<ml:mult style="auto-select"/>
															<ml:real font="0">2</ml:real>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
														<ml:real>1</ml:real>
													</ml:apply>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:plus/>
													<ml:apply>
														<ml:minus/>
														<ml:id xml:space="preserve">α</ml:id>
														<ml:id xml:space="preserve">i</ml:id>
													</ml:apply>
													<ml:real>1</ml:real>
												</ml:apply>
												<ml:apply>
													<ml:plus/>
													<ml:apply>
														<ml:plus/>
														<ml:id xml:space="preserve">α</ml:id>
														<ml:id xml:space="preserve">i</ml:id>
													</ml:apply>
													<ml:real>1</ml:real>
												</ml:apply>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">c</ml:id>
											<ml:apply>
												<ml:minus/>
												<ml:id xml:space="preserve">i</ml:id>
												<ml:real>1</ml:real>
											</ml:apply>
										</ml:apply>
									</ml:apply>
								</ml:localDefine>
							</ml:for>
							<ml:id xml:space="preserve">c</ml:id>
						</ml:program>
					</ml:apply>
				</ml:define>
			</math>
		</region>
		<region region-id="78" left="300" top="555" width="42.75" height="18.75" align-x="325.5" align-y="570" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:apply xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:equal/>
					<ml:apply>
						<ml:id xml:space="preserve">fα</ml:id>
						<ml:id xml:space="preserve">t</ml:id>
					</ml:apply>
					<ml:apply>
						<ml:pow/>
						<ml:id xml:space="preserve">t</ml:id>
						<ml:id xml:space="preserve">α</ml:id>
					</ml:apply>
				</ml:apply>
			</math>
		</region>
		<region region-id="71" left="12" top="667.5" width="135.75" height="74.25" align-x="51" align-y="678" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">spF1</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">L</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:mult style="auto-select"/>
						<ml:apply>
							<ml:sqrt/>
							<ml:id xml:space="preserve">T</ml:id>
						</ml:apply>
						<ml:program>
							<ml:localDefine>
								<ml:apply>
									<ml:indexer/>
									<ml:id xml:space="preserve">c</ml:id>
									<ml:real>0</ml:real>
								</ml:apply>
								<ml:real>1</ml:real>
							</ml:localDefine>
							<ml:for>
								<ml:id xml:space="preserve">i</ml:id>
								<ml:range>
									<ml:real>1</ml:real>
									<ml:apply>
										<ml:minus/>
										<ml:id xml:space="preserve">L</ml:id>
										<ml:real>1</ml:real>
									</ml:apply>
								</ml:range>
								<ml:localDefine>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">c</ml:id>
										<ml:id xml:space="preserve">i</ml:id>
									</ml:apply>
									<ml:real>0</ml:real>
								</ml:localDefine>
							</ml:for>
							<ml:id xml:space="preserve">c</ml:id>
						</ml:program>
					</ml:apply>
				</ml:define>
			</math>
		</region>
		<region region-id="81" left="300" top="669" width="36" height="12.75" align-x="324" align-y="678" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:apply xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:equal/>
					<ml:apply>
						<ml:id xml:space="preserve">f0</ml:id>
						<ml:id xml:space="preserve">t</ml:id>
					</ml:apply>
					<ml:real>1</ml:real>
				</ml:apply>
			</math>
		</region>
		<region region-id="65" left="12" top="758.25" width="397.5" height="12" align-x="39.75" align-y="768" show-border="true" show-highlight="true" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="center" list-style-type="inherit" tabs="inherit">Spectral characteristic of the multiplication operator with power function as a multiplier</p>
			</text>
		</region>
		<region region-id="154" left="12" top="783" width="296.25" height="138.75" align-x="69.75" align-y="792" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">_Atα</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">i</ml:id>
							<ml:id xml:space="preserve">j</ml:id>
							<ml:id xml:space="preserve">α</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:program>
						<ml:sequence>
							<ml:localDefine>
								<ml:id xml:space="preserve">r</ml:id>
								<ml:real>0</ml:real>
							</ml:localDefine>
							<ml:localDefine>
								<ml:id xml:space="preserve">c</ml:id>
								<ml:real>1</ml:real>
							</ml:localDefine>
							<ml:localDefine>
								<ml:id xml:space="preserve">m</ml:id>
								<ml:real>1</ml:real>
							</ml:localDefine>
						</ml:sequence>
						<ml:for>
							<ml:id xml:space="preserve">k</ml:id>
							<ml:range>
								<ml:real>0</ml:real>
								<ml:id xml:space="preserve">j</ml:id>
							</ml:range>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">r</ml:id>
									<ml:apply>
										<ml:plus/>
										<ml:id xml:space="preserve">r</ml:id>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:pow/>
												<ml:parens>
													<ml:real>-1</ml:real>
												</ml:parens>
												<ml:apply>
													<ml:minus/>
													<ml:id xml:space="preserve">j</ml:id>
													<ml:id xml:space="preserve">k</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:id xml:space="preserve">c</ml:id>
										</ml:apply>
									</ml:apply>
								</ml:localDefine>
								<ml:ifThen>
									<ml:apply>
										<ml:lessThan/>
										<ml:id xml:space="preserve">k</ml:id>
										<ml:id xml:space="preserve">j</ml:id>
									</ml:apply>
									<ml:program>
										<ml:localDefine>
											<ml:id xml:space="preserve">c</ml:id>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:id xml:space="preserve">c</ml:id>
														<ml:apply>
															<ml:pow/>
															<ml:parens>
																<ml:apply>
																	<ml:div/>
																	<ml:apply>
																		<ml:plus/>
																		<ml:id xml:space="preserve">α</ml:id>
																		<ml:id xml:space="preserve">m</ml:id>
																	</ml:apply>
																	<ml:id xml:space="preserve">m</ml:id>
																</ml:apply>
															</ml:parens>
															<ml:real>2</ml:real>
														</ml:apply>
													</ml:apply>
													<ml:apply>
														<ml:div/>
														<ml:apply>
															<ml:plus/>
															<ml:apply>
																<ml:minus/>
																<ml:id xml:space="preserve">j</ml:id>
																<ml:id xml:space="preserve">m</ml:id>
															</ml:apply>
															<ml:real>1</ml:real>
														</ml:apply>
														<ml:apply>
															<ml:minus/>
															<ml:apply>
																<ml:plus/>
																<ml:id xml:space="preserve">α</ml:id>
																<ml:id xml:space="preserve">m</ml:id>
															</ml:apply>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:apply>
												<ml:apply>
													<ml:div/>
													<ml:apply>
														<ml:plus/>
														<ml:id xml:space="preserve">j</ml:id>
														<ml:id xml:space="preserve">m</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:plus/>
														<ml:apply>
															<ml:plus/>
															<ml:apply>
																<ml:plus/>
																<ml:id xml:space="preserve">α</ml:id>
																<ml:id xml:space="preserve">m</ml:id>
															</ml:apply>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
														<ml:real>1</ml:real>
													</ml:apply>
												</ml:apply>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:id xml:space="preserve">m</ml:id>
											<ml:apply>
												<ml:plus/>
												<ml:id xml:space="preserve">m</ml:id>
												<ml:real>1</ml:real>
											</ml:apply>
										</ml:localDefine>
									</ml:program>
								</ml:ifThen>
							</ml:program>
						</ml:for>
						<ml:id xml:space="preserve">r</ml:id>
					</ml:program>
				</ml:define>
			</math>
		</region>
		<region region-id="155" left="12" top="933" width="231.75" height="117" align-x="68.25" align-y="942" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">spAtα</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">L</ml:id>
							<ml:id xml:space="preserve">α</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:program>
						<ml:localDefine>
							<ml:id xml:space="preserve">F</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">spFtα</ml:id>
								<ml:sequence>
									<ml:id xml:space="preserve">L</ml:id>
									<ml:id xml:space="preserve">α</ml:id>
								</ml:sequence>
							</ml:apply>
						</ml:localDefine>
						<ml:for>
							<ml:id xml:space="preserve">i</ml:id>
							<ml:range>
								<ml:real font="0">0</ml:real>
								<ml:apply>
									<ml:minus/>
									<ml:id xml:space="preserve">L</ml:id>
									<ml:real>1</ml:real>
								</ml:apply>
							</ml:range>
							<ml:for>
								<ml:id xml:space="preserve">j</ml:id>
								<ml:range>
									<ml:real>0</ml:real>
									<ml:id xml:space="preserve">i</ml:id>
								</ml:range>
								<ml:program>
									<ml:localDefine>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">c</ml:id>
											<ml:sequence>
												<ml:id xml:space="preserve">i</ml:id>
												<ml:id xml:space="preserve">j</ml:id>
											</ml:sequence>
										</ml:apply>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:sqrt/>
													<ml:apply>
														<ml:div/>
														<ml:apply>
															<ml:plus/>
															<ml:apply>
																<ml:mult style="auto-select"/>
																<ml:real font="0">2</ml:real>
																<ml:id xml:space="preserve">j</ml:id>
															</ml:apply>
															<ml:real>1</ml:real>
														</ml:apply>
														<ml:id xml:space="preserve">T</ml:id>
													</ml:apply>
												</ml:apply>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">F</ml:id>
													<ml:id xml:space="preserve">i</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:id xml:space="preserve">_Atα</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">i</ml:id>
													<ml:id xml:space="preserve">j</ml:id>
													<ml:id xml:space="preserve">α</ml:id>
												</ml:sequence>
											</ml:apply>
										</ml:apply>
									</ml:localDefine>
									<ml:ifThen>
										<ml:apply>
											<ml:notEqual/>
											<ml:id xml:space="preserve">i</ml:id>
											<ml:id xml:space="preserve">j</ml:id>
										</ml:apply>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">c</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">j</ml:id>
													<ml:id xml:space="preserve">i</ml:id>
												</ml:sequence>
											</ml:apply>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">c</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">i</ml:id>
													<ml:id xml:space="preserve">j</ml:id>
												</ml:sequence>
											</ml:apply>
										</ml:localDefine>
									</ml:ifThen>
								</ml:program>
							</ml:for>
						</ml:for>
						<ml:id xml:space="preserve">c</ml:id>
					</ml:program>
				</ml:define>
			</math>
		</region>
		<region region-id="84" left="12" top="1064.25" width="397.5" height="12" align-x="39.75" align-y="1074" show-border="true" show-highlight="true" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="center" list-style-type="inherit" tabs="inherit">Spectral characteristic of the fractional integration operator</p>
			</text>
		</region>
		<region region-id="156" left="12" top="1089" width="285" height="132.75" align-x="63" align-y="1098" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">_ID</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">i</ml:id>
							<ml:id xml:space="preserve">j</ml:id>
							<ml:id xml:space="preserve">β</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:program>
						<ml:sequence>
							<ml:localDefine>
								<ml:id xml:space="preserve">r</ml:id>
								<ml:real>0</ml:real>
							</ml:localDefine>
							<ml:localDefine>
								<ml:id xml:space="preserve">c</ml:id>
								<ml:real>1</ml:real>
							</ml:localDefine>
							<ml:localDefine>
								<ml:id xml:space="preserve">m</ml:id>
								<ml:real>1</ml:real>
							</ml:localDefine>
						</ml:sequence>
						<ml:for>
							<ml:id xml:space="preserve">k</ml:id>
							<ml:range>
								<ml:real>0</ml:real>
								<ml:id xml:space="preserve">j</ml:id>
							</ml:range>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">r</ml:id>
									<ml:apply>
										<ml:plus/>
										<ml:id xml:space="preserve">r</ml:id>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:pow/>
												<ml:parens>
													<ml:real>-1</ml:real>
												</ml:parens>
												<ml:apply>
													<ml:minus/>
													<ml:id xml:space="preserve">j</ml:id>
													<ml:id xml:space="preserve">k</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:id xml:space="preserve">c</ml:id>
