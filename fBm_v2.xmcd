		<region region-id="122" left="12" top="2289.75" width="139.5" height="18" align-x="72.75" align-y="2304" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">spInvert</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">t</ml:id>
							<ml:id xml:space="preserve">F</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:mult/>
						<ml:apply>
							<ml:transpose/>
							<ml:id xml:space="preserve">F</ml:id>
						</ml:apply>
						<ml:apply>
							<ml:id xml:space="preserve">pt</ml:id>
							<ml:sequence>
								<ml:apply>
									<ml:id xml:space="preserve">rows</ml:id>
									<ml:id xml:space="preserve">F</ml:id>
								</ml:apply>
								<ml:id xml:space="preserve">t</ml:id>
							</ml:sequence>
						</ml:apply>
