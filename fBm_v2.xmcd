		<region region-id="131" left="12" top="2691" width="178.5" height="63" align-x="27" align-y="2700" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:apply>
						<ml:indexer/>
						<ml:id xml:space="preserve">ε</ml:id>
						<ml:id xml:space="preserve">i</ml:id>
					</ml:apply>
					<ml:program>
						<ml:localDefine>
							<ml:id xml:space="preserve">A</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">spSH</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">L</ml:id>
										<ml:id xml:space="preserve">i</ml:id>
									</ml:apply>
									<ml:id xml:space="preserve">H</ml:id>
								</ml:sequence>
							</ml:apply>
						</ml:localDefine>
						<ml:localDefine>
							<ml:id xml:space="preserve">B</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">spKH</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">L</ml:id>
										<ml:id xml:space="preserve">i</ml:id>
									</ml:apply>
									<ml:id xml:space="preserve">H</ml:id>
								</ml:sequence>
							</ml:apply>
						</ml:localDefine>
						<ml:apply>
							<ml:sqrt/>
							<ml:apply>
								<ml:plus/>
								<ml:apply>
									<ml:minus/>
									<ml:id xml:space="preserve">N2RH</ml:id>
									<ml:apply>
										<ml:id xml:space="preserve">m2</ml:id>
										<ml:id xml:space="preserve">A</ml:id>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:id xml:space="preserve">m2</ml:id>
									<ml:apply>
										<ml:minus/>
										<ml:id xml:space="preserve">A</ml:id>
										<ml:apply>
											<ml:mult/>
											<ml:id xml:space="preserve">B</ml:id>
											<ml:apply>
												<ml:transpose/>
												<ml:id xml:space="preserve">B</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:apply>
								</ml:apply>
							</ml:apply>
						</ml:apply>
					</ml:program>
				</ml:define>
			</math>
		</region>
