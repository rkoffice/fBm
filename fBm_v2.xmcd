													<ml:id xml:space="preserve">c</ml:id>
													<ml:sequence>
														<ml:apply>
															<ml:minus/>
															<ml:id xml:space="preserve">m</ml:id>
															<ml:real>2</ml:real>
														</ml:apply>
														<ml:id xml:space="preserve">m</ml:id>
													</ml:sequence>
												</ml:apply>
											</ml:localDefine>
										</ml:program>
									</ml:ifThen>
								</ml:program>
							</ml:for>
							<ml:id xml:space="preserve">c</ml:id>
						</ml:program>
					</ml:apply>
				</ml:define>
			</math>
		</region>
		<region region-id="117" left="342" top="1527" width="27.75" height="18.75" align-x="354.75" align-y="1542" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:apply xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:equal/>
					<ml:id xml:space="preserve">I2</ml:id>
					<ml:apply>
						<ml:pow/>
						<ml:id xml:space="preserve">I</ml:id>
						<ml:real>2</ml:real>
					</ml:apply>
				</ml:apply>
			</math>
		</region>
		<region region-id="86" left="12" top="1790.25" width="397.5" height="12" align-x="39.75" align-y="1800" show-border="true" show-highlight="true" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="center" list-style-type="inherit" tabs="inherit">Spectral characteristic of the linear integral operator defining the fractional Brownian motion</p>
			</text>
		</region>
		<region region-id="90" left="12" top="1814.25" width="82.5" height="27.75" align-x="45.75" align-y="1830" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">B</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">x</ml:id>
							<ml:id xml:space="preserve">y</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:div/>
						<ml:apply>
							<ml:mult style="auto-select"/>
							<ml:apply>
								<ml:id xml:space="preserve">Γ</ml:id>
								<ml:id xml:space="preserve">x</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">Γ</ml:id>
								<ml:id xml:space="preserve">y</ml:id>
							</ml:apply>
						</ml:apply>
						<ml:apply>
							<ml:id xml:space="preserve">Γ</ml:id>
							<ml:apply>
								<ml:plus/>
								<ml:id xml:space="preserve">x</ml:id>
								<ml:id xml:space="preserve">y</ml:id>
							</ml:apply>
						</ml:apply>
					</ml:apply>
				</ml:define>
			</math>
		</region>
		<region region-id="89" left="12" top="1856.25" width="554.25" height="123.75" align-x="66" align-y="1872" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">spKH</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">L</ml:id>
							<ml:id xml:space="preserve">H</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:program>
						<ml:ifThen>
							<ml:apply>
								<ml:equal/>
								<ml:id xml:space="preserve">H</ml:id>
								<ml:apply>
									<ml:div/>
									<ml:real>1</ml:real>
									<ml:real>2</ml:real>
								</ml:apply>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">spI</ml:id>
								<ml:id xml:space="preserve">L</ml:id>
							</ml:apply>
						</ml:ifThen>
						<ml:ifThen>
							<ml:apply>
								<ml:greaterThan/>
								<ml:id xml:space="preserve">H</ml:id>
								<ml:apply>
									<ml:div/>
									<ml:real>1</ml:real>
									<ml:real>2</ml:real>
								</ml:apply>
							</ml:apply>
							<ml:apply>
								<ml:mult/>
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:sqrt/>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:mult style="auto-select"/>
													<ml:real>2</ml:real>
													<ml:id xml:space="preserve">H</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:parens>
														<ml:apply>
															<ml:minus/>
															<ml:real>1</ml:real>
															<ml:apply>
																<ml:mult style="auto-select"/>
																<ml:real>2</ml:real>
																<ml:id xml:space="preserve">H</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:parens>
													<ml:apply>
														<ml:id xml:space="preserve">B</ml:id>
														<ml:sequence>
															<ml:apply>
																<ml:minus/>
																<ml:real>1</ml:real>
																<ml:apply>
																	<ml:mult style="auto-select"/>
																	<ml:real>2</ml:real>
																	<ml:id xml:space="preserve">H</ml:id>
																</ml:apply>
															</ml:apply>
															<ml:apply>
																<ml:plus/>
																<ml:id xml:space="preserve">H</ml:id>
																<ml:apply>
																	<ml:div/>
																	<ml:real>1</ml:real>
																	<ml:real>2</ml:real>
																</ml:apply>
															</ml:apply>
														</ml:sequence>
													</ml:apply>
												</ml:apply>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:id xml:space="preserve">Γ</ml:id>
											<ml:apply>
												<ml:plus/>
												<ml:id xml:space="preserve">H</ml:id>
												<ml:apply>
													<ml:div/>
													<ml:real>1</ml:real>
													<ml:real>2</ml:real>
												</ml:apply>
											</ml:apply>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:id xml:space="preserve">spID</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">L</ml:id>
													<ml:apply>
														<ml:mult style="auto-select"/>
														<ml:real>2</ml:real>
														<ml:id xml:space="preserve">H</ml:id>
													</ml:apply>
												</ml:sequence>
											</ml:apply>
											<ml:apply>
												<ml:id xml:space="preserve">spAtα</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">L</ml:id>
													<ml:apply>
														<ml:minus/>
														<ml:apply>
															<ml:div/>
															<ml:real>1</ml:real>
															<ml:real>2</ml:real>
														</ml:apply>
														<ml:id xml:space="preserve">H</ml:id>
													</ml:apply>
												</ml:sequence>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:id xml:space="preserve">spID</ml:id>
											<ml:sequence>
												<ml:id xml:space="preserve">L</ml:id>
												<ml:apply>
													<ml:minus/>
													<ml:apply>
														<ml:div/>
														<ml:real>1</ml:real>
														<ml:real>2</ml:real>
													</ml:apply>
													<ml:id xml:space="preserve">H</ml:id>
												</ml:apply>
											</ml:sequence>
										</ml:apply>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:id xml:space="preserve">spAtα</ml:id>
									<ml:sequence>
										<ml:id xml:space="preserve">L</ml:id>
										<ml:apply>
											<ml:minus/>
											<ml:id xml:space="preserve">H</ml:id>
											<ml:apply>
												<ml:div/>
												<ml:real>1</ml:real>
												<ml:real>2</ml:real>
											</ml:apply>
										</ml:apply>
									</ml:sequence>
								</ml:apply>
							</ml:apply>
						</ml:ifThen>
						<ml:ifThen>
							<ml:apply>
								<ml:lessThan/>
								<ml:id xml:space="preserve">H</ml:id>
								<ml:apply>
									<ml:div/>
									<ml:real>1</ml:real>
									<ml:real>2</ml:real>
								</ml:apply>
							</ml:apply>
							<ml:apply>
								<ml:mult/>
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:sqrt/>
													<ml:apply>
														<ml:div/>
														<ml:apply>
															<ml:mult/>
															<ml:id xml:space="preserve">H</ml:id>
															<ml:parens>
																<ml:apply>
																	<ml:minus/>
																	<ml:apply>
																		<ml:mult style="auto-select"/>
																		<ml:real>2</ml:real>
																		<ml:id xml:space="preserve">H</ml:id>
																	</ml:apply>
																	<ml:real>1</ml:real>
																</ml:apply>
															</ml:parens>
														</ml:apply>
														<ml:apply>
															<ml:id xml:space="preserve">B</ml:id>
															<ml:sequence>
																<ml:apply>
																	<ml:minus/>
																	<ml:real>2</ml:real>
																	<ml:apply>
																		<ml:mult style="auto-select"/>
																		<ml:real>2</ml:real>
																		<ml:id xml:space="preserve">H</ml:id>
																	</ml:apply>
																</ml:apply>
																<ml:apply>
																	<ml:minus/>
																	<ml:id xml:space="preserve">H</ml:id>
																	<ml:apply>
																		<ml:div/>
																		<ml:real>1</ml:real>
																		<ml:real>2</ml:real>
																	</ml:apply>
																</ml:apply>
															</ml:sequence>
														</ml:apply>
													</ml:apply>
												</ml:apply>
												<ml:apply>
													<ml:id xml:space="preserve">Γ</ml:id>
													<ml:apply>
														<ml:minus/>
														<ml:id xml:space="preserve">H</ml:id>
														<ml:apply>
															<ml:div/>
															<ml:real>1</ml:real>
															<ml:real>2</ml:real>
														</ml:apply>
													</ml:apply>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:id xml:space="preserve">spI</ml:id>
												<ml:id xml:space="preserve">L</ml:id>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:id xml:space="preserve">spAtα</ml:id>
											<ml:sequence>
												<ml:id xml:space="preserve">L</ml:id>
												<ml:apply>
													<ml:minus/>
													<ml:id xml:space="preserve">H</ml:id>
													<ml:apply>
														<ml:div/>
														<ml:real>1</ml:real>
														<ml:real>2</ml:real>
													</ml:apply>
												</ml:apply>
											</ml:sequence>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:id xml:space="preserve">spID</ml:id>
										<ml:sequence>
											<ml:id xml:space="preserve">L</ml:id>
											<ml:apply>
												<ml:minus/>
												<ml:id xml:space="preserve">H</ml:id>
												<ml:apply>
													<ml:div/>
													<ml:real>1</ml:real>
													<ml:real>2</ml:real>
												</ml:apply>
											</ml:apply>
										</ml:sequence>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:id xml:space="preserve">spAtα</ml:id>
									<ml:sequence>
										<ml:id xml:space="preserve">L</ml:id>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:div/>
												<ml:real>1</ml:real>
												<ml:real>2</ml:real>
											</ml:apply>
											<ml:id xml:space="preserve">H</ml:id>
										</ml:apply>
									</ml:sequence>
								</ml:apply>
							</ml:apply>
						</ml:ifThen>
					</ml:program>
				</ml:define>
			</math>
		</region>
		<region region-id="104" left="12" top="1994.25" width="397.5" height="12" align-x="39.75" align-y="2004" show-border="true" show-highlight="true" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="center" list-style-type="inherit" tabs="inherit">Two-dimensional spectral characteristic of the covariance function</p>
			</text>
		</region>
		<region region-id="119" left="12" top="2019" width="289.5" height="114" align-x="64.5" align-y="2028" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">spSH</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">L</ml:id>
							<ml:id xml:space="preserve">H</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:program>
						<ml:localDefine>
							<ml:id xml:space="preserve">F1</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">spF1</ml:id>
								<ml:id xml:space="preserve">L</ml:id>
							</ml:apply>
						</ml:localDefine>
						<ml:localDefine>
							<ml:id xml:space="preserve">Ft2H</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">spFtα</ml:id>
								<ml:sequence>
									<ml:id xml:space="preserve">L</ml:id>
									<ml:apply>
										<ml:mult style="auto-select"/>
										<ml:real font="0">2</ml:real>
										<ml:id xml:space="preserve">H</ml:id>
									</ml:apply>
								</ml:sequence>
							</ml:apply>
						</ml:localDefine>
						<ml:ifThen>
							<ml:apply>
								<ml:equal/>
								<ml:id xml:space="preserve">H</ml:id>
								<ml:apply>
									<ml:div/>
									<ml:real>1</ml:real>
									<ml:real>2</ml:real>
								</ml:apply>
							</ml:apply>
							<ml:localDefine>
								<ml:id xml:space="preserve">I</ml:id>
								<ml:apply>
									<ml:id xml:space="preserve">spI2</ml:id>
									<ml:id xml:space="preserve">L</ml:id>
								</ml:apply>
							</ml:localDefine>
						</ml:ifThen>
						<ml:otherwise>
							<ml:localDefine>
								<ml:id xml:space="preserve">I</ml:id>
								<ml:apply>
									<ml:id xml:space="preserve">spID</ml:id>
									<ml:sequence>
										<ml:id xml:space="preserve">L</ml:id>
										<ml:apply>
											<ml:plus/>
											<ml:apply>
												<ml:mult style="auto-select"/>
												<ml:real font="0">2</ml:real>
												<ml:id xml:space="preserve">H</ml:id>
											</ml:apply>
											<ml:real>1</ml:real>
										</ml:apply>
									</ml:sequence>
								</ml:apply>
							</ml:localDefine>
						</ml:otherwise>
						<ml:apply>
							<ml:div/>
							<ml:apply>
								<ml:minus/>
								<ml:apply>
									<ml:minus/>
									<ml:apply>
										<ml:plus/>
										<ml:apply>
											<ml:mult/>
											<ml:id xml:space="preserve">Ft2H</ml:id>
											<ml:apply>
												<ml:transpose/>
												<ml:id xml:space="preserve">F1</ml:id>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:mult/>
											<ml:id xml:space="preserve">F1</ml:id>
											<ml:apply>
												<ml:transpose/>
												<ml:id xml:space="preserve">Ft2H</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:id xml:space="preserve">Γ</ml:id>
											<ml:apply>
												<ml:plus/>
												<ml:apply>
													<ml:mult style="auto-select"/>
													<ml:real font="0">2</ml:real>
													<ml:id xml:space="preserve">H</ml:id>
												</ml:apply>
												<ml:real>1</ml:real>
											</ml:apply>
										</ml:apply>
										<ml:id xml:space="preserve">I</ml:id>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:id xml:space="preserve">Γ</ml:id>
										<ml:apply>
											<ml:plus/>
											<ml:apply>
												<ml:mult style="auto-select"/>
												<ml:real font="0">2</ml:real>
												<ml:id xml:space="preserve">H</ml:id>
											</ml:apply>
											<ml:real>1</ml:real>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:transpose/>
										<ml:id xml:space="preserve">I</ml:id>
									</ml:apply>
								</ml:apply>
							</ml:apply>
							<ml:real>2</ml:real>
						</ml:apply>
					</ml:program>
				</ml:define>
			</math>
		</region>
		<region region-id="102" left="12" top="2144.25" width="397.5" height="12" align-x="39.75" align-y="2154" show-border="true" show-highlight="true" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="center" list-style-type="inherit" tabs="inherit">Spectral characteristic of the Gaussian white noise</p>
			</text>
		</region>
		<region region-id="103" left="12" top="2169" width="114.75" height="12.75" align-x="63.75" align-y="2178" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">spGWN</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">L</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:id xml:space="preserve">rnorm</ml:id>
						<ml:sequence>
							<ml:id xml:space="preserve">L</ml:id>
							<ml:real>0</ml:real>
