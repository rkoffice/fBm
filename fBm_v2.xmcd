		<region region-id="99" left="12" top="2319" width="132.75" height="12.75" align-x="41.25" align-y="2328" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">spBH</ml:id>
					<ml:apply>
						<ml:mult/>
						<ml:apply>
							<ml:id xml:space="preserve">spKH</ml:id>
							<ml:sequence>
								<ml:id xml:space="preserve">L</ml:id>
